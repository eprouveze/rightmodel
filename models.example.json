{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RightModel Configuration",
  "description": "User-defined models, pricing, candidates, and task-class capability priors for RightModel.",
  "models": {
    "local-llama-coding": {
      "provider": "local",
      "input_price_usd_per_m": 0.0,
      "output_price_usd_per_m": 0.0,
      "allowed_taints": [
        "public",
        "internal",
        "customer_pii",
        "prospect_pii",
        "payment_data",
        "voice_dna",
        "private_repo_code"
